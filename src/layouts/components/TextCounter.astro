---
interface Props {
  dataCounterTime?: string;
  value: number | string;
}

const { value, dataCounterTime = "1800" } = Astro.props;

// Strip any decoration so the counter script always sees a plain integer.
const numeric = String(value).replace(/[^\d]/g, "");
---

<span class="counter" data-counter-time={dataCounterTime} set:html={numeric} />
