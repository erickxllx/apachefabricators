---
import config from "@/config/config.json";

interface Props {
  class?: string;
  src?: string;
}

const { class: className, src } = Astro.props;
const { logo, logo_width, logo_height, logo_text, title } = config.site;
---

<a href="/" class="inline-block" aria-label={`${logo_text || title} — home`}>
  <img
    src={src || logo}
    alt={logo_text || title}
    width={logo_width}
    height={logo_height}
    class={`w-auto ${className ?? "h-[72px]"}`}
    loading="eager"
    decoding="async"
  />
</a>
