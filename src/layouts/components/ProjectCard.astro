---
import ImageMod from "@/components/ImageMod.astro";
import { markdownify, plainify } from "@/lib/utils/textConverter";

type Props = {
  content: {
    id: string;
    data: {
      title: string;
      image?: string;
      category?: string;
      description?: string;
    };
  };
};

const { content } = Astro.props;
const { image, title, category, description } = content.data;

// Where no licensed mark is available, the card states the standard
// typographically instead. It never imitates a certification body's seal.
const wordmark = title.match(/^(ISO|ASME|AISC|API)\s*([\d:]+)?/i);
---

<article
  class="flex h-full flex-col border border-border bg-body p-6 text-left">
  {
    image ? (
      <div class="flex h-[140px] items-center justify-center" aria-hidden="true">
        {/* The card names the certification in text below, so the seal itself
            is decorative and must not be announced twice. */}
        <ImageMod
          src={image}
          width={280}
          class="max-h-[140px] w-auto object-contain"
          alt={title}
        />
      </div>
    ) : (
      <div
        class="flex h-[140px] flex-col items-center justify-center border border-border bg-light px-4 text-center"
        aria-hidden="true">
        <span class="font-secondary text-3xl font-bold leading-none tracking-tight text-dark">
          {wordmark ? wordmark[1].toUpperCase() : title}
        </span>
        {wordmark?.[2] && (
          <span class="data mt-1 text-xl font-bold text-dark">
            {wordmark[2]}
          </span>
        )}
        <span class="mt-3 border-t border-border pt-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-text">
          Certified
        </span>
      </div>
    )
  }

  <div class="mt-6 border-t border-border pt-5">
    {
      category && (
        <p class="label mb-2">
          {category}
        </p>
      )
    }
    {title && <h3 class="h6 mb-2" set:html={markdownify(title)} />}
    {
      description && (
        <p class="text-sm leading-6 text-text-dark/75">
          {plainify(description)}
        </p>
      )
    }
  </div>
</article>
