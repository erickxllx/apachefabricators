---
import { humanize } from "@/lib/utils/textConverter";

interface Props {
  class?: string;
  title?: string;
}

const { class: className, title }: Props = Astro.props;

const paths = Astro.url.pathname.split("/").filter((x) => x);

// The route segment is not always what the section is called. /projects holds
// the certifications, and the crumb should say so.
const segmentLabels: Record<string, string> = {
  projects: "Certifications",
};

type Crumb = {
  label: string;
  href: string;
  "aria-current"?: "page";
};

let parts: Crumb[] = [
  {
    label: "Home",
    href: "/",
    "aria-current": Astro.url.pathname === "/" ? "page" : undefined,
  },
];

paths.forEach((label: string, i: number) => {
  // Trailing slash, to match how the rest of the site links and how Apache
  // serves these paths. Without it every crumb costs a redirect.
  const href = `/${paths.slice(0, i + 1).join("/")}/`;

  if (label !== "page" && label !== "categories" && label !== "tags") {
    parts.push({
      label:
        segmentLabels[label] ??
        (humanize(label.replace(".html", "").replace(/[-_]/g, " ")) || ""),
      href,
      "aria-current": Astro.url.pathname === href ? ("page" as const) : undefined,
    });
  }
});

// Sobrescribe el último label si se pasa title
if (title && parts.length > 1) {
  parts[parts.length - 1].label = title;
}
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="breadcrumb">
    {
      parts.map(({ label, ...attrs }, index) => (
        <li class="capitalize text-white font-medium">
          {index !== parts.length - 1 ? (
            <a class="text-white hover:text-primary" {...attrs}>
              {label}
            </a>
          ) : (
            <span class="text-sm" aria-current="page" set:html={label} />
          )}
        </li>
      ))
    }
  </ol>
</nav>
