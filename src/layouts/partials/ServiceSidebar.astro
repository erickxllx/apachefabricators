---
import config from "@/config/config.json";
import DynamicIcon from "@/helpers/DynamicIcon";
import { markdownify } from "@/lib/utils/textConverter";

type Entry = {
  id: string;
  data: { title: string; regular_day?: string; regular_time?: string; off_day?: string };
};

type Props = {
  content: Entry;
  servicesCollection: Entry[];
};

const { content, servicesCollection } = Astro.props;
const { regular_day, regular_time, off_day } = content.data;

const { phone, email } = config.params.contact_info;
const phoneDisplay = phone.replace(
  /^\+1(\d{3})(\d{3})(\d{4})$/,
  "+1 ($1) $2-$3",
);
---

<aside class="lg:col-4 lg:order-1 order-2">
  <div class="flex flex-col gap-10 lg:gap-14">
    {
      servicesCollection && (
        <nav aria-label="Services">
          <ul class="border border-border">
            {servicesCollection.map((serviceItem) => {
              const { title } = serviceItem.data;
              if (!title) return null;
              const isCurrent = serviceItem.id === content.id;

              return (
                <li class="border-b border-border last:border-b-0">
                  {/* The link is built from the entry id. Building it from
                      slugify(title) produced URLs that did not exist. */}
                  <a
                    href={`/services/${serviceItem.id}/`}
                    aria-current={isCurrent ? "page" : undefined}
                    class={`block px-6 py-4 text-sm font-semibold uppercase tracking-[0.08em] transition-colors ${
                      isCurrent
                        ? "bg-primary text-white"
                        : "text-text-dark hover:bg-light hover:text-primary"
                    }`}
                    set:html={markdownify(title)}
                  />
                </li>
              );
            })}
          </ul>
        </nav>
      )
    }

    <div class="border border-border p-6">
      <h2 class="h6 mb-4">Opening Hours</h2>
      <dl class="space-y-2">
        {
          regular_time && (
            <div class="flex justify-between gap-4 text-sm">
              <dt class="text-text">{regular_day}</dt>
              <dd class="data text-text-dark">{regular_time}</dd>
            </div>
          )
        }
        {
          off_day && (
            <div class="flex justify-between gap-4 text-sm">
              <dt class="text-text">{off_day}</dt>
              <dd class="data text-text-dark">Closed</dd>
            </div>
          )
        }
      </dl>
    </div>

    <div class="border border-border p-6">
      <h2 class="h6 mb-2">Request a quote</h2>
      <p class="mb-5 text-sm leading-6 text-text-dark/75">
        Send drawings or a scope of work and we will come back with pricing and
        a schedule.
      </p>
      <ul class="mb-5 space-y-2 text-sm">
        <li class="flex items-center gap-2">
          <DynamicIcon icon="TfiHeadphoneAlt" className="text-secondary" />
          <a class="data" href={`tel:${phone}`}>{phoneDisplay}</a>
        </li>
        <li class="flex items-center gap-2">
          <DynamicIcon icon="TfiEmail" className="text-secondary" />
          <a href={`mailto:${email}`}>{email}</a>
        </li>
      </ul>
      <a class="btn btn-primary btn-sm w-full" href="/contact/">Contact us</a>
    </div>
  </div>
</aside>
