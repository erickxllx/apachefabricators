---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import bgImageMod from "@/lib/utils/bgImageMod";
import { humanize } from "@/lib/utils/textConverter";

interface Props {
  title: string;
  meta_title?: string;
  bg_image?: string;
  class?: string;
}

const {
  title,
  meta_title,
  bg_image = "/images/banner/banner-4.jpg",
  class: className,
} = Astro.props;

// Section Background Images
const pageHeaderBgImage = await bgImageMod(bg_image);
---

<section
  class={`overlay bg-no-repeat bg-center bg-cover min-h-[320px] lg:min-h-[420px] flex ${className ?? ""}`}
  style={`background-image: url(${pageHeaderBgImage})`}>
  <div
    class="container overlay-content flex w-full flex-col items-start justify-center py-16 text-left">
    <h1
      class="text-white"
      set:text={humanize(meta_title ? meta_title : title)}
    />
    <Breadcrumbs class="mt-3" title={title} />
  </div>
</section>
