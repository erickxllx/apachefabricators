---
import Logo from "@/components/Logo.astro";
import Preloader from "@/components/Preloader.astro";
import Social from "@/components/Social.astro";
import config from "@/config/config.json";
import DynamicIcon from "@/helpers/DynamicIcon";
import menu from "@/config/menu.json";
import social from "@/config/social.json";

const { phone, email } = config.params.contact_info;
const phoneDisplay = phone.replace(
  /^\+1(\d{3})(\d{3})(\d{4})$/,
  "+1 ($1) $2-$3",
);
const credit = config.params.credit;
const address = "8101 E Mt Houston Rd. Houston, TX 77050";
const mapsHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(address)}`;
const year = new Date().getFullYear();
---

<footer class="bg-dark text-white">
  <div class="border-b border-white/15 py-14">
    <div class="container">
      <div class="grid gap-10 md:grid-cols-3 md:gap-8">
        <!-- Column 1: identity -->
        <div>
          <Logo src="/images/logo-light.png" class="h-[56px]" />
          <p class="mt-5 max-w-[38ch] text-sm leading-6 text-white/75">
            {config.params.footer_description}
          </p>
          {
            social.main?.length > 0 && (
              <Social source={social.main} className="social-icons mt-6" />
            )
          }
        </div>

        <!-- Column 2: navigation -->
        <nav aria-label="Footer">
          <h2
            class="kicker kicker-quiet mb-5 !text-white/55">
            Site
          </h2>
          <ul class="space-y-3">
            {
              (menu.main ?? []).map((item) => (
                <li>
                  <a
                    href={item.url}
                    class="text-sm uppercase tracking-[0.06em] text-white transition-colors hover:text-secondary">
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <!-- Column 3: contact -->
        <div>
          <h2
            class="kicker kicker-quiet mb-5 !text-white/55">
            Contact
          </h2>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <DynamicIcon
                icon="TfiLocationPin"
                className="mt-1 shrink-0 text-secondary"
              />
              <a
                href={mapsHref}
                target="_blank"
                rel="noopener"
                class="text-white transition-colors hover:text-secondary">
                {address}
              </a>
            </li>
            <li class="flex items-start gap-3">
              <DynamicIcon
                icon="TfiEmail"
                className="mt-1 shrink-0 text-secondary"
              />
              <a
                href={`mailto:${email}`}
                class="text-white transition-colors hover:text-secondary">
                {email}
              </a>
            </li>
            <li class="flex items-start gap-3">
              <DynamicIcon
                icon="TfiHeadphoneAlt"
                className="mt-1 shrink-0 text-secondary"
              />
              <a
                href={`tel:${phone}`}
                class="data text-white transition-colors hover:text-secondary">
                {phoneDisplay}
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="py-6">
    <div class="container">
      <div
        class="flex flex-col items-center justify-between gap-2 text-sm sm:flex-row">
        <p class="m-0 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-white/70">
          <span>&copy; {year} {config.params.copyright}</span>
          <a
            href="/privacy-policy/"
            class="text-white/70 transition-colors hover:text-secondary">
            Privacy Policy
          </a>
        </p>
        {
          credit?.url && (
            <p class="m-0 text-white/50">
              {credit.label}{" "}
              <a
                href={credit.url}
                target="_blank"
                rel="noopener"
                class="text-white/75 underline decoration-white/25 underline-offset-4 transition-colors hover:text-secondary hover:decoration-secondary">
                {credit.name}
              </a>
            </p>
          )
        }
      </div>
    </div>
  </div>
</footer>
{config.params.preloder && <Preloader />}

<script>
  import { Swiper } from "swiper";
  import "swiper/css";
  import {
    A11y,
    Autoplay,
    Keyboard,
    Navigation,
    Pagination,
    Thumbs,
  } from "swiper/modules";

  // Wait for the DOM, not for every image. Waiting on `load` left the sliders
  // dead and the preloader up until the last asset had downloaded.
  const start = () => {
    const body = document.body;

    // Nothing auto-advances when the visitor has asked for reduced motion.
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const autoplay = (delay: number) =>
      reduceMotion ? false : { delay, pauseOnMouseEnter: true };

    document.querySelector(".preloader")?.classList.add("hidden");

    document.querySelector(".back-to-top")?.addEventListener("click", () => {
      document.body.scrollTop = 0;
      document.documentElement.scrollTop = 0;
    });

    document.querySelectorAll(".nav-dropdown .nav-link").forEach((navlink) => {
      navlink.addEventListener("click", function (this: HTMLElement) {
        this.parentElement?.classList.toggle("active");
      });
    });

    // Hero slider
    const bannerNavSlider = new Swiper(".banner-nav-slider", {
      spaceBetween: 10,
      slidesPerView: 4,
      watchSlidesProgress: true,
    });
    new Swiper(".banner-slider", {
      modules: [Navigation, Pagination, Autoplay, Thumbs, A11y, Keyboard],
      slidesPerView: 1,
      // `rewind` instead of `loop`: loop clones slides, which duplicated the
      // hero heading several times over in the DOM.
      rewind: true,
      autoplay: autoplay(10000),
      keyboard: { enabled: true },
      a11y: { enabled: true },
      navigation: {
        nextEl: ".swiper-navigation .next-arrow",
        prevEl: ".swiper-navigation .prev-arrow",
      },
      thumbs: { swiper: bannerNavSlider },
    });

    // Certification slider
    const certSlider = new Swiper(".work-slider", {
      modules: [Pagination, Autoplay, A11y, Keyboard],
      loop: true,
      // Was 1000ms, which made the certifications unreadable.
      autoplay: autoplay(7000),
      keyboard: { enabled: true },
      a11y: { enabled: true },
      pagination: {
        el: ".work-slider + .swiper-pagination",
        clickable: true,
      },
      breakpoints: {
        0: { slidesPerView: 1 },
        576: { slidesPerView: 2 },
        768: { slidesPerView: 3 },
        991: { slidesPerView: 4 },
      },
    });

    // Visible, permanent pause control (WCAG 2.2.2)
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-slider-toggle]",
    );
    if (toggle) {
      if (reduceMotion) {
        toggle.hidden = true;
      } else {
        let playing = true;
        const paint = () => {
          toggle.setAttribute("aria-pressed", String(!playing));
          toggle.textContent = playing ? "Pause" : "Play";
        };
        toggle.addEventListener("click", () => {
          playing = !playing;
          if (playing) certSlider.autoplay?.start();
          else certSlider.autoplay?.stop();
          paint();
        });
        paint();
      }
    }

    // Testimonial slider
    new Swiper(".testimonial-slider", {
      modules: [Navigation, Autoplay, A11y, Keyboard],
      slidesPerView: 1,
      centeredSlides: true,
      spaceBetween: 80,
      autoplay: autoplay(8000),
      keyboard: { enabled: true },
      a11y: { enabled: true },
      navigation: {
        prevEl: ".swiper-navigation .prevArrow",
        nextEl: ".swiper-navigation .nextArrow",
      },
    });

    // Client logo slider
    new Swiper(".client-logo-slider", {
      modules: [Autoplay, A11y],
      loop: true,
      autoplay: autoplay(5000),
      a11y: { enabled: true },
      breakpoints: {
        0: { slidesPerView: 2 },
        576: { slidesPerView: 3 },
        1024: { slidesPerView: 5 },
      },
    });

    // Counters
    document
      .querySelectorAll<HTMLElement>(".counter")
      .forEach((item) => {
        const target = parseInt(item.innerText.replace(/\D/g, ""), 10) || 0;
        if (reduceMotion) {
          item.innerText = target.toLocaleString("en-US");
          return;
        }
        let fired = false;
        const run = () => {
          if (fired) return;
          const rect = item.getBoundingClientRect();
          if (rect.top > window.innerHeight || rect.bottom < 0) return;
          fired = true;
          const started = performance.now();
          const tick = (now: number) => {
            const progress = Math.min((now - started) / 1200, 1);
            item.innerText = Math.ceil(target * progress).toLocaleString(
              "en-US",
            );
            if (progress < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        run();
        window.addEventListener("scroll", run, { passive: true });
      });

    // Navbar toggler
    const navbarToggler = document.querySelector(".navbar-toggler");
    navbarToggler?.addEventListener("click", function () {
      const open = navbarToggler.classList.toggle("active");
      body.classList.toggle("navbar-nav-collapsed");
      navbarToggler.setAttribute("aria-expanded", String(open));
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", start);
  } else {
    start();
  }
</script>
