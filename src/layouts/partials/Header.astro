---
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
const { pathname } = Astro.url;

const phone = config.params.contact_info.phone;
// +18328046236 -> +1 (832) 804-6236
const phoneDisplay = phone.replace(
  /^\+1(\d{3})(\d{3})(\d{4})$/,
  "+1 ($1) $2-$3",
);
const navButton = config.navigation_button;
---

<header class="header header-dark relative z-20 bg-dark text-white">
  <nav class="navbar container">
    <!-- logo -->
    <div class="order-0">
      <Logo src="/images/logo-light.png" class="h-[72px]" />
    </div>

    <!-- navbar toggler -->
    <button
      class="relative group order-3 navbar-toggler cursor-pointer lg:hidden lg:order-1"
      aria-label="Toggle navigation"
      aria-expanded="false">
      <div
        class="relative flex h-[24px] w-[18px] items-center justify-center overflow-hidden">
        <div
          class="flex h-[14px] w-full origin-center flex-col justify-between overflow-hidden">
          <div class="h-[2px] w-full origin-left bg-white transition-transform duration-300 delay-100 group-[.active]:translate-y-6"></div>
          <div class="h-[2px] w-full rounded bg-white transition-transform duration-300 delay-75 group-[.active]:translate-y-6"></div>
          <div class="h-[2px] w-full origin-left bg-white transition-transform duration-300 group-[.active]:translate-y-6"></div>
          <div
            class="absolute top-1/2 flex w-0 -translate-x-10 items-center justify-between transition-transform duration-500 group-[.active]:w-12 group-[.active]:translate-x-0">
            <div class="absolute h-[2px] w-5 rotate-0 bg-white transition-transform duration-500 delay-300 group-[.active]:rotate-45"></div>
            <div class="absolute h-[2px] w-5 -rotate-0 bg-white transition-transform duration-500 delay-300 group-[.active]:-rotate-45"></div>
          </div>
        </div>
      </div>
    </button>

    <div class="navbar-nav-wrapper max-lg:w-full order-3 lg:ml-auto lg:order-1">
      <ul class="navbar-nav lg:flex lg:w-auto lg:space-x-1 xl:space-x-2">
        {
          main.map((menu) => (
            <>
              {menu.hasChildren ? (
                <li class="nav-dropdown nav-item group relative">
                  <span
                    class={`nav-link inline-flex items-center ${
                      menu.children?.map(({ url }) => url).includes(pathname) ||
                      menu.children
                        ?.map(({ url }) => `${url}/`)
                        .includes(pathname)
                        ? "active"
                        : ""
                    }`}>
                    {menu.name}
                    <svg
                      class="h-4 w-4 fill-current ml-1 arrow-icon"
                      viewBox="0 0 20 20">
                      <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                    </svg>
                  </span>
                  <div class="nav-dropdown-menu">
                    <ul class="nav-dropdown-list">
                      {menu.children?.map((child) => (
                        <li class="nav-dropdown-item">
                          <a
                            href={child.url}
                            class={`nav-dropdown-link block ${
                              (pathname === `${child.url}/` ||
                                pathname === child.url) &&
                              "active"
                            }`}>
                            {child.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ) : (
                <li class="nav-item">
                  <a
                    href={menu.url}
                    class={`nav-link block ${
                      (pathname === `${menu.url}/` || pathname === menu.url) &&
                      "active"
                    }`}>
                    {menu.name}
                  </a>
                </li>
              )}
            </>
          ))
        }

        <!-- Mobile call to action -->
        <li
          class="mt-5 flex flex-col gap-3 max-lg:w-full max-lg:items-center lg:hidden">
          {
            navButton.enable && (
              <a class="btn btn-primary-white btn-sm" href={navButton.link}>
                {navButton.label}
              </a>
            )
          }
          <a class="btn btn-outline-light btn-sm" href={`tel:${phone}`}>
            {phoneDisplay}
          </a>
        </li>
      </ul>
    </div>

    <!-- Desktop call to action -->
    <div class="order-1 ml-auto flex items-center gap-5 md:order-2 lg:ml-6">
      <a
        class="hidden text-[13px] font-extrabold tracking-[0.04em] text-white/85 transition-colors hover:text-white lg:inline-block"
        href={`tel:${phone}`}>
        {phoneDisplay}
      </a>
      {
        navButton.enable && (
          <a
            class="btn btn-primary-white btn-sm hidden lg:inline-flex"
            href={navButton.link}>
            {navButton.label}
          </a>
        )
      }
    </div>
  </nav>
</header>
