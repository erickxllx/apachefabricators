---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";
import { getEntry, type CollectionEntry } from "astro:content";

const qualityIndex = (await getEntry(
  "quality",
  "-index",
)) as CollectionEntry<"quality">;

const { title, meta_title, description, image, philosophy, safety, protocols } =
  qualityIndex.data;

type Pair = {
  title?: string;
  body?: string;
  image?: string;
};

// The content schema stores each subsection as a flat subtitle/content/image
// triplet. Collapsing them into a list removes five near-identical markup
// blocks and keeps the alternating layout in one place.
const safetyPairs: Pair[] = [
  { title: safety?.subtitleB, body: safety?.contentB, image: safety?.imageB },
  { title: safety?.subtitleC, body: safety?.contentC, image: safety?.imageC },
].filter((pair) => pair.title || pair.body);

const protocolPairs: Pair[] = [
  {
    title: protocols?.subtitle,
    body: protocols?.content,
    image: protocols?.image,
  },
  {
    title: protocols?.subtitleB,
    body: protocols?.contentB,
    image: protocols?.imageB,
  },
  {
    title: protocols?.subtitleC,
    body: protocols?.contentC,
    image: protocols?.imageC,
  },
].filter((pair) => pair.title || pair.body);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}>
  <PageHeader title={title} bg_image="/images/quality.jpg" />

  {/* 01 - Philosophy */}
  {
    philosophy?.enable && (
      <section class="section text-left">
        <div class="container">
          <p class="kicker mb-3">Quality</p>

          <div class="grid gap-x-12 gap-y-8 lg:grid-cols-12">
            <header class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start">
              {philosophy.title && (
                <h2 set:html={markdownify(philosophy.title)} />
              )}
            </header>

            {philosophy.content && (
              <div class="lg:col-span-6 lg:col-start-7">
                <p
                  class="max-w-[68ch] text-base leading-7"
                  set:html={markdownify(philosophy.content)}
                />
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {/* 02 - Safety */}
  {
    safety?.enable && (
      <section class="section border-y border-border bg-light text-left">
        <div class="container">
          <p class="kicker mb-3">Safety</p>

          <div class="grid gap-x-12 gap-y-8 lg:grid-cols-12">
            <header class="lg:col-span-5 lg:sticky lg:top-28 lg:self-start">
              {safety.title && <h2 set:html={markdownify(safety.title)} />}
              {safety.subtitle && (
                <p
                  class="mt-4 max-w-[40ch] text-lg text-text-dark/80"
                  set:html={markdownify(safety.subtitle)}
                />
              )}
            </header>

            {safety.content && (
              <div class="lg:col-span-6 lg:col-start-7">
                <p
                  class="max-w-[68ch] text-base leading-7"
                  set:html={markdownify(safety.content)}
                />
              </div>
            )}
          </div>

          {safetyPairs.length > 0 && (
            <div class="mt-16 space-y-16 lg:mt-24 lg:space-y-24">
              {safetyPairs.map((pair, index) => (
                <article class="grid items-center gap-x-12 gap-y-6 lg:grid-cols-2">
                  <div class={index % 2 === 1 ? "lg:order-2" : ""}>
                    {pair.image && (
                      <div class="flex items-center justify-center border border-border bg-body">
                        <ImageMod
                          src={pair.image}
                          width={900}
                          class="max-h-[560px] w-full object-contain"
                          alt={pair.title || "Apache Fabricators safety program"}
                        />
                      </div>
                    )}
                  </div>

                  <div class={index % 2 === 1 ? "lg:order-1" : ""}>
                    {pair.title && <h3 set:html={markdownify(pair.title)} />}
                    {pair.body && (
                      <p
                        class="mt-4 max-w-[62ch] text-base leading-7"
                        set:html={markdownify(pair.body)}
                      />
                    )}
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  {/* 03 - Protocols */}
  {
    protocols?.enable && (
      <section class="section text-left">
        <div class="container">
          <p class="kicker mb-3">Protocols</p>

          {protocols.title && (
            <h2
              class="max-w-[24ch]"
              set:html={markdownify(protocols.title)}
            />
          )}

          {protocolPairs.length > 0 && (
            <div class="mt-16 space-y-16 lg:mt-24 lg:space-y-24">
              {protocolPairs.map((pair, index) => (
                <article class="grid items-center gap-x-12 gap-y-6 lg:grid-cols-2">
                  <div class={index % 2 === 1 ? "lg:order-2" : ""}>
                    {pair.image && (
                      <div class="flex items-center justify-center border border-border bg-body">
                        <ImageMod
                          src={pair.image}
                          width={900}
                          class="max-h-[560px] w-full object-contain"
                          alt={
                            pair.title || "Apache Fabricators safety protocols"
                          }
                        />
                      </div>
                    )}
                  </div>

                  <div class={index % 2 === 1 ? "lg:order-1" : ""}>
                    {pair.title && <h3 set:html={markdownify(pair.title)} />}
                    {pair.body && (
                      <p
                        class="mt-4 max-w-[62ch] text-base leading-7"
                        set:html={markdownify(pair.body)}
                      />
                    )}
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }
</Base>
