---
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import { markdownify, plainify } from "@/lib/utils/textConverter";
import PageHeader from "@/partials/PageHeader.astro";
import { getEntry, type CollectionEntry } from "astro:content";

const qualityIndex = (await getEntry(
  "quality",
  "-index",
)) as CollectionEntry<"quality">;

const { title, meta_title, description, image, philosophy, safety, protocols } =
  qualityIndex.data;

const certifications = await getSinglePage("projects");

const phone = config.params.contact_info.phone;
const phoneDisplay = phone.replace(
  /^\+1(\d{3})(\d{3})(\d{4})$/,
  "+1 ($1) $2-$3",
);

type Block = { title?: string; body?: string };

const safetyBlocks: Block[] = [
  { title: safety?.subtitleB, body: safety?.contentB },
  { title: safety?.subtitleC, body: safety?.contentC },
].filter((b) => b.title || b.body);

const protocolBlocks: Block[] = [
  { title: protocols?.subtitle, body: protocols?.content },
  { title: protocols?.subtitleB, body: protocols?.contentB },
  { title: protocols?.subtitleC, body: protocols?.contentC },
].filter((b) => b.title || b.body);

// Scope lines keep the certification list readable without the seal artwork.
const scopeOf = (cert: any) =>
  cert.data.overview?.find((row: any) => row.label === "Scope")?.data ?? "";
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}>
  <PageHeader title={title} bg_image="/images/quality.jpg" />

  {/* Quality statement */}
  {
    philosophy?.enable && (
      <section class="section">
        <div class="container">
          <div class="grid gap-x-16 gap-y-8 lg:grid-cols-12">
            <div class="lg:col-span-5">
              {philosophy.subtitle && (
                <p class="kicker" set:html={markdownify(philosophy.subtitle)} />
              )}
              {philosophy.title && (
                <h2
                  class="mt-4 max-w-[14ch]"
                  set:html={markdownify(philosophy.title)}
                />
              )}
            </div>
            {philosophy.content && (
              <div class="lg:col-span-7">
                <p
                  class="max-w-[62ch] text-[21px] leading-[1.55] text-text-dark"
                  set:html={markdownify(philosophy.content)}
                />
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {/* Certifications, set as a list rather than a wall of seals */}
  <section class="section bg-dark text-white">
    <div class="container">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="kicker">Audited</p>
          <h2 class="mt-4 max-w-[18ch] text-white">
            Backed by {certifications.length} current certifications
          </h2>
        </div>
        <a class="btn btn-outline-light btn-sm shrink-0" href="/projects">
          See certifications
        </a>
      </div>

      <dl class="border-t border-white/20">
        {
          certifications.map((cert, index) => (
            <div class="grid gap-x-8 gap-y-1 border-b border-white/20 py-5 sm:grid-cols-[auto_1fr_1.1fr] sm:items-baseline">
              <span class="data text-sm text-white/40">
                {String(index + 1).padStart(2, "0")}
              </span>
              <dt class="text-lg font-bold text-white">{cert.data.title}</dt>
              <dd class="m-0 text-[15px] leading-6 text-white/60">
                {scopeOf(cert)}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* Safety culture */}
  {
    safety?.enable && (
      <section class="section">
        <div class="container">
          <div class="grid gap-x-16 gap-y-8 lg:grid-cols-12">
            <header class="lg:col-span-5">
              <p class="kicker">Safety</p>
              {safety.title && (
                <h2 class="mt-4" set:html={markdownify(safety.title)} />
              )}
              {safety.subtitle && (
                <p
                  class="mt-3 max-w-[30ch] text-lg text-text"
                  set:html={markdownify(safety.subtitle)}
                />
              )}
            </header>
            {safety.content && (
              <div class="lg:col-span-7">
                <p class="max-w-[64ch]" set:html={markdownify(safety.content)} />
              </div>
            )}
          </div>

          {safety.programs && safety.programs.length > 0 && (
            <dl class="mt-16 border-t border-border">
              {safety.programs.map((program, index) => (
                <div class="grid gap-x-10 gap-y-2 border-b border-border py-8 lg:grid-cols-[4rem_16rem_1fr]">
                  <span class="data text-sm text-secondary">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <dt class="h5">{program.title}</dt>
                  <dd class="m-0 max-w-[64ch] text-text">
                    {plainify(program.description)}
                  </dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </section>
    )
  }

  {/* The goal, in the company's own words */}
  {
    safety?.statement && (
      <section class="border-y-2 border-secondary bg-light">
        <div class="container">
          <blockquote class="m-0 py-16 lg:py-20">
            <p class="max-w-[15em] text-[clamp(1.75rem,1.2rem+2.2vw,3rem)] font-extrabold leading-[1.12] tracking-[-0.03em] text-text-dark">
              {plainify(safety.statement)}
            </p>
          </blockquote>
        </div>
      </section>
    )
  }

  {/* Training and drug-free policy */}
  {
    safetyBlocks.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="grid gap-x-16 gap-y-12 lg:grid-cols-2">
            {safetyBlocks.map((block) => (
              <article>
                {block.title && (
                  <h3 class="h4 border-t-2 border-text-dark pt-5">
                    {block.title}
                  </h3>
                )}
                {block.body && (
                  <p class="mt-5 max-w-[60ch] text-text">
                    {plainify(block.body)}
                  </p>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Practices and protocols */}
  {
    protocols?.enable && (
      <section class="section border-t border-border bg-light">
        <div class="container">
          <div class="max-w-[60ch]">
            <p class="kicker">Protocols</p>
            {protocols.title && (
              <h2
                class="mt-4 max-w-[20ch]"
                set:html={markdownify(protocols.title)}
              />
            )}
          </div>

          {protocols.steps && protocols.steps.length > 0 && (
            <>
              <p class="label mt-12">New hire orientation, step by step</p>
              <ol class="mt-5 grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-5">
                {protocols.steps.map((step, index) => (
                  <li class="flex flex-col bg-body p-6">
                    <span class="data text-sm text-secondary">
                      Step {String(index + 1).padStart(2, "0")}
                    </span>
                    <h3 class="h6 mt-3 border-t border-border pt-3">
                      {step.title}
                    </h3>
                    <ul class="mt-3 space-y-2">
                      {step.points.map((point) => (
                        <li class="flex gap-2 text-[14px] leading-6 text-text">
                          <span
                            aria-hidden="true"
                            class="mt-[9px] h-[4px] w-[4px] shrink-0 bg-secondary"
                          />
                          <span>{point}</span>
                        </li>
                      ))}
                    </ul>
                  </li>
                ))}
              </ol>
            </>
          )}

          <div class="mt-16 grid gap-x-16 gap-y-12 lg:grid-cols-3">
            {protocolBlocks.map((block) => (
              <article>
                {block.title && (
                  <h3 class="h5 border-t-2 border-text-dark pt-5">
                    {block.title}
                  </h3>
                )}
                {block.body && (
                  <p class="mt-4 text-[15px] leading-6 text-text">
                    {plainify(block.body)}
                  </p>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* Close */}
  <section class="bg-dark text-white">
    <div class="container">
      <div class="flex flex-wrap items-center justify-between gap-8 py-14">
        <div>
          <h2 class="max-w-[22ch] text-white">
            Need our safety record for a prequalification?
          </h2>
          <p class="mt-4 max-w-[52ch] text-white/65">
            We can supply certificates, training records and EHS metrics on
            request.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/contact">Contact us</a>
          <a class="btn btn-outline-light" href={`tel:${phone}`}>
            {phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
