---
import Base from "@/layouts/Base.astro";
import { getEntry } from "astro:content";
import { getSinglePage } from "@/lib/contentParser.astro";
import bgImageMod from "@/lib/utils/bgImageMod";
import { markdownify } from "@/lib/utils/textConverter";
import ServiceCard from "@/components/ServiceCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import OurExpertise from "@/partials/OurExpertise.astro";
import MissionVision from "@/partials/MissionVision.astro";
import ImageMod from "@/components/ImageMod.astro";
import config from "@/config/config.json";
import type { CollectionEntry } from "astro:content";

const missionVisionContent = (
  (await getEntry(
    "missionVisionSection",
    "mission-vision",
  )) as CollectionEntry<"missionVisionSection">
).data;
const ourExpertiseContent = (
  (await getEntry(
    "ourExpertiseSection",
    "our-expertise",
  )) as CollectionEntry<"ourExpertiseSection">
).data;

const servicesCollection = await getSinglePage("services");
const projectsCollection = await getSinglePage("projects");

const homepageIndex = (await getEntry(
  "homepage",
  "-index",
)) as CollectionEntry<"homepage">;

const { banner_slider, service, about, project, mission, our_expertise } =
  homepageIndex?.data;

const hero = banner_slider?.slider_item?.[0];
const aboutBgImage = await bgImageMod(about?.bg_image!);

const phone = config.params.contact_info.phone;
const phoneDisplay = phone.replace(
  /^\+1(\d{3})(\d{3})(\d{4})$/,
  "+1 ($1) $2-$3",
);

// The facts a buyer checks first. Every one is verifiable.
const quickSpec = [
  { k: "Shop", v: "60,000 sq ft" },
  { k: "Yard", v: "13.0 acres" },
  { k: "Certifications", v: projectsCollection.length + " current" },
  { k: "Hours", v: "Mon-Fri 8-5" },
];
---

<Base>
  {
    hero && (
      <section class="relative overflow-hidden bg-dark text-white">
        {/* The photograph bleeds to the right edge and takes the full height of
            the section on wide screens, so the dark ground stops dominating. */}
        {hero.bg_image && (
          <figure class="relative m-0 lg:absolute lg:right-0 lg:top-0 lg:h-full lg:w-[46%] xl:w-[48%]">
            <ImageMod
              src={hero.bg_image}
              width={1400}
              class="aspect-[16/10] h-full w-full object-cover sm:aspect-[21/9] lg:aspect-auto"
              alt="Welder at the Apache Fabricators shop in Houston"
              loading="eager"
            />
            <span
              class="pointer-events-none absolute inset-y-0 left-0 hidden w-24 bg-gradient-to-r from-dark to-transparent lg:block"
              aria-hidden="true"
            />
            <figcaption class="kicker absolute bottom-0 left-0 bg-secondary px-4 py-3 !text-white lg:bottom-8 lg:left-8">
              ASME &middot; AISC &middot; ISO
            </figcaption>
          </figure>
        )}

        <div class="container">
          <div class="relative z-10 flex flex-col justify-center py-14 lg:min-h-[580px] lg:w-[52%] lg:py-20 xl:min-h-[640px]">
            {hero.title && (
              <h1 class="text-white" set:html={markdownify(hero.title)} />
            )}
            {hero.subtitle && (
              <p
                class="mt-5 max-w-[42ch] text-lg text-white/70"
                set:html={markdownify(hero.subtitle)}
              />
            )}
            {hero.content && (
              <p
                class="mt-4 max-w-[48ch] text-white/60"
                set:html={markdownify(hero.content)}
              />
            )}
            <div class="mt-9 flex flex-wrap gap-3">
              <a class="btn btn-primary" href="/contact/">
                Request a quote
              </a>
              <a class="btn btn-outline-light" href={"tel:" + phone}>
                {phoneDisplay}
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="border-b border-border bg-light">
    <div class="container">
      <dl class="grid gap-7 py-7 sm:grid-cols-2 lg:grid-cols-4">
        {
          quickSpec.map((item) => (
            <div>
              <dt class="label">
                {item.k}
              </dt>
              <dd class="data mt-1 text-[26px] font-bold text-text-dark">
                {item.v}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {
    service?.enable && (
      <section class="section">
        <div class="container">
          <div class="mb-11 max-w-[60ch]">
            <p class="kicker">Markets</p>
            {service.title && (
              <h2
                class="mt-2 max-w-[24ch]"
                set:html={markdownify(service.title)}
              />
            )}
            {service.subtitle && (
              <p class="mt-3" set:html={markdownify(service.subtitle)} />
            )}
          </div>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {servicesCollection.slice(0, 6).map((item) => (
              <ServiceCard content={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    about?.enable && (
      <section
        class="section-sm lg:section overlay bg-cover bg-no-repeat"
        style={{ backgroundImage: "url(" + aboutBgImage + ")" }}>
        <div class="container overlay-content">
          <div class="row">
            <div class="lg:col-6 ml-auto">
              <div class="bg-dark/95 px-8 py-10 sm:px-10 sm:py-12">
                <p class="kicker">Capabilities</p>
                {about.title && (
                  <h2
                    class="mt-2 text-white"
                    set:html={markdownify(about.title)}
                  />
                )}
                {about.content && (
                  <p
                    class="my-7 text-white/70"
                    set:html={markdownify(about.content)}
                  />
                )}
                {about.bulletPoint && (
                  <ul class="mb-8 grid gap-2 sm:grid-cols-2">
                    {about.bulletPoint.map((point: string) => (
                      <li class="flex items-baseline gap-2 text-white">
                        <span class="h-[5px] w-[5px] shrink-0 rounded-full bg-secondary" />
                        <span set:html={markdownify(point)} />
                      </li>
                    ))}
                  </ul>
                )}
                <a href="/services/" class="btn btn-primary">
                  All services
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {our_expertise?.enable && <OurExpertise content={ourExpertiseContent} />}

  {
    project?.enable && (
      <section class="section border-t border-border bg-light">
        <div class="container">
          <div class="mb-9 flex flex-wrap items-end justify-between gap-5">
            <div class="max-w-[60ch]">
              <p class="kicker">Verified</p>
              {project.title && (
                <h2
                  class="mt-2 max-w-[24ch]"
                  set:html={markdownify(project.title)}
                />
              )}
              {project.subtitle && (
                <p class="mt-3" set:html={markdownify(project.subtitle)} />
              )}
            </div>
            {/* Permanent pause control: auto-advancing content needs one. */}
            <button
              type="button"
              data-slider-toggle
              aria-pressed="false"
              class="btn btn-outline-dark btn-sm shrink-0">
              Pause
            </button>
          </div>

          <div
            class="work-slider swiper"
            role="region"
            aria-label="Certifications held by Apache Fabricators">
            <div class="swiper-wrapper">
              {projectsCollection.map((item) => (
                <div class="swiper-slide h-auto">
                  <ProjectCard content={item} />
                </div>
              ))}
            </div>
          </div>
          <div class="swiper-pagination pagination-rounded" />
        </div>
      </section>
    )
  }

  {mission?.enable && <MissionVision content={missionVisionContent} />}
</Base>
