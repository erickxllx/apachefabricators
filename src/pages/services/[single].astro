---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";
import ServiceSidebar from "@/partials/ServiceSidebar.astro";
import { render } from "astro:content";

// Both collections live under /services. Building only one of them left the
// other's detail pages unreachable.
export async function getStaticPaths() {
  const industries = await getSinglePage("services");
  const capabilities = await getSinglePage("servicesMain");

  return [
    ...industries.map((service) => ({
      params: { single: service.id },
      props: { service, siblings: industries, kind: "industry" },
    })),
    ...capabilities.map((service) => ({
      params: { single: service.id },
      props: { service, siblings: capabilities, kind: "capability" },
    })),
  ];
}

const { service, siblings, kind } = Astro.props;
const { title, meta_title, description, image, detail_image, bg_image } =
  service.data;

// Detail pages get the full photograph; the small cutout is for cards only.
const hero = detail_image || image;

const { Content } = await render(service);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}>
  <PageHeader title={title} bg_image={bg_image} />

  <section class="section">
    <div class="container">
      <div class="row gy-4">
        <ServiceSidebar content={service} servicesCollection={siblings} />
        <article class="lg:col-8 lg:order-2 order-1">
          {
            hero &&
              (kind === "industry" ? (
                /* Scene photography fills its frame. */
                <figure class="mb-10 m-0 overflow-hidden border border-border md:mb-14">
                  <ImageMod
                    src={hero}
                    width={1200}
                    class="aspect-[16/10] w-full object-cover"
                    alt={title}
                    loading="eager"
                  />
                </figure>
              ) : (
                /* Cutouts sit on a light band so the transparency reads. */
                <figure class="mb-10 flex items-center justify-center border border-border bg-light p-5 md:mb-14 md:p-8">
                  <ImageMod
                    src={hero}
                    width={1000}
                    class="max-h-[460px] w-auto max-w-full object-contain"
                    alt={title}
                    loading="eager"
                  />
                </figure>
              ))
          }
          {
            service.body && (
              <div class="content">
                <Content />
              </div>
            )
          }
        </article>
      </div>
    </div>
  </section>
</Base>
